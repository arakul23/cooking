{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "strict": true,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve"
    },
    "include": [
        "src/frontend/**/*.ts",
        "src/frontend/**/*.vue"
    ],
    "exclude": [
        "node_modules",
        ".nuxt"
    ]
}
